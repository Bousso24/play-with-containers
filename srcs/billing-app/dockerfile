FROM alpine:3.20
RUN apk update && apk add --no-cache \
    python3 \
    py3-pip \
    python3-dev \
    build-base \
    postgresql-dev \
    bash

WORKDIR /app
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH="/app"
RUN python3 -m venv /venv
ENV PATH="/venv/bin:$PATH"
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt
COPY . .
EXPOSE 8080

CMD ["python3", "app/consumer.py"]
